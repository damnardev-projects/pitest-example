<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>fr.damnardev.example</groupId>
		<artifactId>pitest-example-internal-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pitest-example-internal-parent/pom.xml</relativePath>
	</parent>

	<artifactId>pitest-example-module-A</artifactId>
	<packaging>jar</packaging>

	<name>Pitest Example - Module A</name>
	<description>Module A for the Pitest example</description>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<executions>
					<execution>
						<id>run-mutation-tests</id>
						<goals>
							<goal>mutationCoverage</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<targetClasses>
						<param>fr.damnardev.example.moduleA.*</param>
					</targetClasses>
					<targetTests>
						<param>fr.damnardev.example.moduleA.*</param>
					</targetTests>
					<mutators>
						<mutator>ALL</mutator>
					</mutators>
					<exportLineCoverage>true</exportLineCoverage>
					<outputFormats>
						<value>XML</value>
					</outputFormats>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
