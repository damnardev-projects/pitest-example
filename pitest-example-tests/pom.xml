<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>fr.damnardev.example</groupId>
		<artifactId>pitest-example-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pitest-example-parent/pom.xml</relativePath>
	</parent>

	<artifactId>pitest-example-tests</artifactId>
	<packaging>pom</packaging>

	<name>Pitest Example - Tests</name>
	<description>Integration and aggregate tests for the Pitest example</description>

	<properties>
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>fr.damnardev.example</groupId>
			<artifactId>pitest-example-module-A</artifactId>
		</dependency>
		<dependency>
			<groupId>fr.damnardev.example</groupId>
			<artifactId>pitest-example-module-B</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report-aggregate</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<executions>
					<execution>
						<id>put-it-together</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
